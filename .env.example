# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration (for local development)
DATABASE_URL="file:./data/warroom.db"

# Next.js Configuration
NODE_ENV=development

# Per-officer chat history depth (number of previous exchanges to remember)
OFFICER_MEMORY_DEPTH=5

# Officer memory mode: how officers see conversation history
# - "isolated": Officers only see their own previous responses (current behavior)
# - "collaborative": Officers see all peers' previous responses
OFFICER_MEMORY_MODE=isolated
