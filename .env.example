# OpenRouter API Key (optional - only needed if not using demo mode)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Demo Mode (set to "true" for Vercel deployment to enable demo mode)
# When enabled, shows hardcoded demo responses instead of calling OpenRouter API
# Users can optionally provide their own API key to switch to live mode
NEXT_PUBLIC_DEMO_MODE=true

# Site Configuration (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=War Room

# Database (optional - for future persistence features)
DATABASE_URL="file:./data/warroom.db"
